FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-too

DATABASE_URL=postgresql://postgres@127.0.0.1:5433/stayed_db
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

AUTO_PROVISION_DB=1
DB_CONTAINER_NAME=stayed-postgres
DB_DOCKER_IMAGE=postgres:16

# Command the backend runs to score a learner (stdin: JSON features, stdout:
# JSON with risk_probability). Point it at this machine's venv python and
# models/predict_bridge.py. Wrap the whole value in single quotes so
# python-dotenv treats the two double-quoted paths as one value, e.g.:
#   MODEL_COMMAND='"C:/path/to/StayEd_Backend/.venv/Scripts/python.exe" "C:/path/to/StayEd_Backend/models/predict_bridge.py"'
# Train the model first with: python models/train_model.py
MODEL_COMMAND=
STAYED_R_MODEL=
STAYED_RISK_CLASS=NotCompleted