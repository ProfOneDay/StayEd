FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-too

# Add :YOUR_PASSWORD after postgres if your local PostgreSQL server requires one.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/stayed_db
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Optional real Random Forest integration. Leave blank until the trained model is exported.
MODEL_COMMAND=
STAYED_R_MODEL=
STAYED_RISK_CLASS=NotCompleted
