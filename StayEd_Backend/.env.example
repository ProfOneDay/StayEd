FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-too

# Add :YOUR_PASSWORD after postgres if your local PostgreSQL server requires one.
# Port 5433 matches the stayed-postgres Docker container (see sql/00_core_schema.sql setup notes),
# used because a default local PostgreSQL install already occupies 5432.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/stayed_db
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# When DATABASE_URL points at localhost, run.py auto-creates/starts the Docker
# Postgres container and applies StayEd_Backend/sql/*.sql the first time the
# database is empty (see app/db_bootstrap.py). Set to 0 to manage the database
# yourself instead.
AUTO_PROVISION_DB=1
DB_CONTAINER_NAME=stayed-postgres
DB_DOCKER_IMAGE=postgres:16

# Optional real Random Forest integration. Leave blank until the trained model is exported.
MODEL_COMMAND=
STAYED_R_MODEL=
STAYED_RISK_CLASS=NotCompleted
